# Copy to ~/.config/aula-agent/env and `chmod 600` it. Read by both the weekly script and the bot.
# Never commit the real file.

# Discord
DISCORD_BOT_TOKEN=replace-with-bot-token
DISCORD_OWNER_ID=123456789012345678          # your Discord user ID (Developer Mode → Copy User ID)
DISCORD_CHANNEL_ID=123456789012345678        # the private channel the bot lives in
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN   # fallback for the weekly post

# Home Assistant push nudge
HA_URL=http://homeassistant.local:8123
HA_NOTIFY_SERVICE=notify/mobile_app_your_phone
HA_TOKEN=replace-with-long-lived-access-token

# Optional
# CLAUDE_BIN=/home/you/.local/bin/claude
