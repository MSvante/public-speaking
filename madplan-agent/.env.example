# Copy to ~/.config/madplan-agent/env and `chmod 600` it. Read by the bot (systemd EnvironmentFile)
# and by madplan-mcp (inherited from the bot, or read directly from this file). Never commit the real file.

# Discord
DISCORD_BOT_TOKEN=replace-with-bot-token

# Supabase project behind your recipe site. Use the anon/publishable key and a dedicated bot
# user, NOT the service role key, so Row Level Security still applies to the agent.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-with-anon-key
MADPLAN_EMAIL=madplan-bot@example.com
MADPLAN_PASSWORD=replace-with-bot-user-password
MADPLAN_SITE=https://recipes.example.com

# Optional
# MADPLAN_CONFIG=/home/you/.config/madplan-agent/config.json
# CLAUDE_BIN=/home/you/.local/bin/claude
